# Copy to .env and fill in real values (never commit .env)
PORT=3000
JWT_SECRET=please-set-a-long-random-string
# PERSIST_DIR is used on Render only (path to the persistent disk)
PERSIST_DIR=
# Which python binary powers the gait analyzer (unset = auto-detect)
GAIT_PYTHON=
# Max analyzer runtime in milliseconds (default 45 min)
GAIT_ANALYZER_TIMEOUT=2700000
# Max per-plane OpenCV video OCR step runtime in milliseconds (default 5 min)
GAIT_OCR_TIMEOUT=300000
# Comma-separated list of allowed browser origins for the mobile app shell
CORS_ORIGINS=https://localhost,capacitor://localhost,https://capacitor.local
# Set to "true" only for development; not for production
CORS_ALLOW_ANY=false
# Base URL the smoke-test script hits (scripts/smoke-test.js)
SMOKE_BASE=http://127.0.0.1:3000